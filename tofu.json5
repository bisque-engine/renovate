{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: {
    addLabels: ["renovate:opentofu"],
    additionalBranchPrefix: "tofu/",
    commitMessageTopic: "🌎 OpenTofu Provider {{{depName}}}",
    matchDatasources: ["terraform-provider", "terraform-module"],
    registryUrls: ["https://registry.opentofu.org"],
    rangeStrategy: "pin",
    pin: {
      groupName: "OpenTofu",
      group: {
        commitMessageTopic: "🌎 {{{groupName}}} Providers",
      }
    },
  }
}

